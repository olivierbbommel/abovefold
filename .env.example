# Abovefold settings. `scripts/setup.sh` creates .env from this file and fills
# in every generated secret for you; you only need to provide the OpenRouter key.
# Generate a secret by hand with: openssl rand -base64 32

# --- Required -----------------------------------------------------------

# The address people will use to reach this instance, with https and no
# trailing slash. Used for redirects, image proxying and newsletter links.
ABOVEFOLD_PUBLIC_URL=https://news.example.com

# The password you log in with (single user).
ABOVEFOLD_PASSWORD=

# Signs the login cookie. Any long random string.
ABOVEFOLD_SESSION_SECRET=

# OpenRouter key for embeddings and summaries: https://openrouter.ai/keys
# Typical cost is about 2 US cents per 100 articles.
OPENROUTER_API_KEY=

# Database password (internal to Docker).
POSTGRES_PASSWORD=

# Miniflux (the feed fetcher) admin account and API token. setup.sh mints the
# token for you; the admin account also works for Miniflux's own UI and for
# reader apps that speak the Fever or Google Reader API.
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=
MINIFLUX_API_TOKEN=

# --- Optional -----------------------------------------------------------

# Stop paying for summaries once this much (USD) is spent in a month.
# Fetching and reading keep working; new stories just arrive unsummarised.
ABOVEFOLD_MONTHLY_COST_CAP_USD=5

# Your time zone, for "Today" and dates (IANA name, e.g. Europe/London).
ABOVEFOLD_TIMEZONE=UTC

# Local port the web app listens on (always bound to 127.0.0.1).
ABOVEFOLD_PORT=8090

# A request header carrying the real client IP that your proxy sets and
# clients cannot forge, used to throttle login attempts per client:
# cf-connecting-ip behind a Cloudflare tunnel, x-real-ip behind nginx.
# Leave empty to throttle all login attempts together.
ABOVEFOLD_CLIENT_IP_HEADER=

# OpenRouter models. Defaults: openai/text-embedding-3-small and
# google/gemini-2.5-flash-lite. The embedding model must produce 1536 dims.
ABOVEFOLD_EMBED_MODEL=
ABOVEFOLD_SUMMARY_MODEL=

# --- Newsletters by email (optional, needs your own domain) ------------------
# See docs/newsletters.md. Leave empty to turn the feature off.

# The domain newsletter addresses live on, e.g. example.com gives addresses
# like stratechery.1a2b3c4d@example.com.
ABOVEFOLD_INBOUND_DOMAIN=

# Shared secret between your Cloudflare Email Worker and this instance.
ABOVEFOLD_INBOUND_SECRET=
